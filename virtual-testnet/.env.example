FORK_URL=https://ethereum-rpc.publicnode.com
FORK_BLOCK=        # optional, leave empty for latest
BLOCK_TIME=auto    # auto or e.g. 12
CHAIN_ID=1
PORT=8545

# Crash survival — anvil aborts if an upstream RPC call fails while mining.
# STATE_DIR already defaults to /data; mount a volume there so state survives
# redeploys too. Only set this if you want a different path.
# STATE_DIR=/data
STATE_INTERVAL=30       # seconds between state dumps to disk

# Upstream RPC resilience (anvil defaults: 5 retries / 45000ms / no backoff)
FORK_RETRIES=10
FORK_TIMEOUT=120000     # ms
FORK_RETRY_BACKOFF=1000 # ms
NO_RATE_LIMIT=true

# States kept for the last N blocks, none on disk; "off" keeps full history
PRUNE_HISTORY=64

# Restart anvil cleanly past this RSS, below the container memory limit (0 = off)
MAX_RSS_MB=5120

# Optional: 'shanghai' removes the EIP-4788/EIP-2935 system-contract writes
# that force an upstream storage read on every mined block. Leave empty for
# the fork's own hardfork (needed for blobs / Cancun+ opcodes).
HARDFORK=

# Supervisor tuning
BOOT_TIMEOUT=180
RESTART_DELAY=2
RESTART_DELAY_MAX=60